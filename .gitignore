node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.env
# Everything in certs/ is a local secret. Ignore the directory, not a list of
# extensions: a backup like localhost-key.pem.bak slipped past the *.pem rule.
certs/*
!certs/.gitkeep
frontend/dist/
.DS_Store
*.log
.office-addin-dev-certs/
scripts/*.xlsx
# macOS / iCloud conflict copies. The suffix increments, so "foo 2.py" was only
# the first generation; "package-lock 3.json" walked straight past the old rule.
* [0-9].*
* [0-9]/

# Internal working docs: superseded drafts and the interview score log. Kept on
# disk for reference, but they are not part of the submission — the README's
# "deliberately left out" table explains why the drafts were cut.
docs/AGENT_WORKFLOW.md
docs/FINAL_PLAN.md
docs/TEAM_PROMPT.md
docs/SCORE_HISTORY.md
